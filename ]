package set1

import (
	"crypto-challenges/cryptoutil"
	"io"
	"os"
	"testing"
)

func TestChallenge06_BreakRepeatingKeyXOR(t *testing.T) {
	file, err := os.Open("testdata/6.txt")
	if err != nil {
		t.Fatalf("failed to open testdata/4.txt: %v", err)
	}
	content, err := io.ReadAll(file)
	if err != nil {
		t.Fatalf("failed to read content of testdata/4.txt: %v", err)
	}
	defer file.Close()
	bestHamDistance := 1000 
	for keySize := 2; keySize < 40; keySize++ {
		chunk1 := content[0:keySize]
		chunk2 := content[keySize : keySize+keySize]
		hammingDistance, err := cryptoutil.FindHammingDistance(chunk1, chunk2)
		if err != nil {
			t.Fatalf("unexpected error calculating hamming distance: %v", err)
		}

		if (hammingDistance / keySize) < bestHamDistance
	}

	// input1 := []byte("karolin")
